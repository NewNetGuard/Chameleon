[Unit]
Description=Install Chameleon fail-closed guards before networking
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target network.target network-online.target
Before=chameleon-dns.service chameleon-resume.service chameleon-panel.service

[Service]
Type=oneshot
ExecStart=/usr/lib/chameleon/chameleon-runner chameleon-netctl guard
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=network-pre.target
