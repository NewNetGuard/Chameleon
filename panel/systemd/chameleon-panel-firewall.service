[Unit]
Description=Close the Chameleon Panel port to everything but the local network
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target chameleon-panel.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/chameleon/panel.env
ExecStart=/usr/lib/chameleon/chameleon-panel-firewall apply
ExecStop=/usr/lib/chameleon/chameleon-panel-firewall remove
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=network-pre.target
