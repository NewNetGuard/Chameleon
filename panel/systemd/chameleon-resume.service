[Unit]
Description=Restore the Chameleon tunnel and strict routing after boot
After=network-online.target chameleon-guard.service chameleon-dns.service
Wants=network-online.target chameleon-dns.service
Requires=chameleon-guard.service
Before=chameleon-panel.service

[Service]
Type=oneshot
ExecStart=/usr/lib/chameleon/chameleon-runner chameleon-netctl resume
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
